# Copy to .env and fill in. .env is gitignored.
#
# NOTE: this app reads configuration from environment variables only -- there
# is no config.json and no /data mount in this codebase.

# --- Firefly III (required) -------------------------------------------------
# Public base URL of the Firefly III instance. Reachable over HTTPS.
FIREFLY_URL=https://finances.example.com

# Personal Access Token: Firefly III > Options > Profile > OAuth > Personal Access Tokens
FIREFLY_PERSONAL_TOKEN=

# --- LLM (required) --------------------------------------------------------
# Upstream hardcodes the legacy /v1/completions endpoint with
# gpt-3.5-turbo-instruct, so this must be a working OpenAI key for the LLM leg
# to succeed. A placeholder is enough to boot the container and observe the
# 401 in the queue UI.
OPENAI_API_KEY=sk-dummy-invalid

# --- Optional --------------------------------------------------------------
# Serves the queue monitor UI at /
ENABLE_UI=true

# Tag applied to transactions that were categorized.
FIREFLY_TAG=AI categorized

# Port the app listens on *inside* the container. Keep 3000 to match the
# port mapping in docker-compose.yml (127.0.0.1:13000:3000).
PORT=3000

# Classify as usual but never write back to Firefly III; every decision is
# logged instead. Use it to validate a build against production data first.
DRY_RUN=false

TZ=Europe/Madrid
