# Copy to .env, fill in what you need, then `docker compose up -d`.
# .env is gitignored — never commit real credentials.
#
# Every value can also be set through the web UI; a value saved in the UI wins
# over the environment. See the README for the full table.

# --- Firefly III (required) ------------------------------------------------
# Public base URL of the Firefly III instance, reachable over HTTPS.
FIREFLY_URL=https://finances.example.com

# Firefly III > Options > Profile > OAuth > Personal Access Tokens
FIREFLY_PERSONAL_TOKEN=

# --- AI provider -----------------------------------------------------------
# AI_PROVIDER: openai | gemini | deepseek            (default: openai)
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point this at Ollama or any OpenAI-compatible endpoint to keep data local.
OPENAI_BASE_URL=

GEMINI_API_KEY=
# Left unset on purpose: the binary then uses its own default, which is
# gemini-3.1-flash-lite in this build. Uncomment to pin a model you have
# verified against your account — an empty assignment is not the same thing.
#GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Server ----------------------------------------------------------------
PORT=3000
ENABLE_UI=true
# Path to the persisted settings file (mounted at /data in the image).
CONFIG_FILE=/data/config.json
# Prefix for the tags written back to transactions (ai:classified, ...).
TAG_PREFIX=ai

# --- Processing ------------------------------------------------------------
WORKER_CONCURRENCY=1
BATCH_CONCURRENCY=5
HISTORY_CONTEXT_LIMIT=5
HISTORY_LOOKBACK_DAYS=90
HISTORY_CACHE_TTL=10m
# Env-var equivalent of Settings → Behaviour → "Set destination account
# automatically".
DESTINATION_MATCH_ENABLED=false

# Env-var equivalent of Settings → Behaviour → "Learn merchant names from
# descriptions". Asks the model to name the merchant when a transaction has no
# usable payee, and remembers it so repeat descriptions skip the model call.
# Never written to Firefly III; the memory is lost on restart.
MERCHANT_LOOKUP_ENABLED=false

# Classify as usual but never write to Firefly III; every decision is logged
# instead. Use it to validate a build against production data first.
DRY_RUN=false

# Container timezone (the image ships tzdata); set it to yours if dates matter.
TZ=UTC

# --- Docker Compose only ---------------------------------------------------
# Which image tag docker-compose.yml runs. `latest` follows this fork's main
# branch; pin a release (2.0.0) to stay on a fixed build. The server itself
# never reads this variable.
AICAT_TAG=latest
